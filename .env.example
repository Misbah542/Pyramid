# Optional. A GitHub personal access token with NO scopes (public data only) lifts the
# public API rate limit from 60 to 5,000 requests/hour. It is read server-side only and is
# never sent to the browser.
GITHUB_TOKEN=

# Port the analysis API listens on (the Vite dev server proxies /api here).
API_PORT=8787

# Analysis resource limits (all optional, defaults shown).
MAX_TREE_ENTRIES=40000
MAX_PARSED_FILES=1800
MAX_FILE_BYTES=400000
ANALYSIS_TIMEOUT_MS=90000
